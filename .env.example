# Alibaba Cloud Model Studio (Bailian). Replace YOUR_WORKSPACE_ID and never commit real keys.
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://YOUR_WORKSPACE_ID.cn-beijing.maas.aliyuncs.com/compatible-mode/v1

# Optional independent credentials. When blank, DASHSCOPE_* above is used.
LLM_API_KEY=
LLM_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=

LLM_MODEL=deepseek-v4-pro
LLM_TIMEOUT_SECONDS=60
RERANK_MODEL=deepseek-v4-pro
HYBRID_RERANK_ENABLED=true

EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1024
EMBEDDING_BATCH_SIZE=10

VECTOR_INDEX_PATH=knowledge/index/vectors.json

# Supabase backend database. Prefer the new sb_secret_... key.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Legacy fallback only:
SUPABASE_SERVICE_ROLE_KEY=
